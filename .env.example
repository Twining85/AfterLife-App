# Niemals echte Geheimnisse in diese Datei eintragen oder committen.
SMTP_HOST=SMTP_HOSTNAME
SMTP_PORT=587
SMTP_USER=SMTP_USERNAME
SMTP_PASSWORD=PLACEHOLDER
SMTP_FROM=Tschlüssli <ABSENDER_EMAIL>
SMTP_REPLY_TO=ANTWORT_EMAIL
EMAIL_VERIFICATION_SECRET=PLACEHOLDER
EMAIL_VERIFICATION_ALLOWED_RECIPIENTS=DEV_TEST_EMAIL_1,DEV_TEST_EMAIL_2
EMAIL_VERIFICATION_ALLOW_UNLISTED=false
EMAIL_VERIFICATION_BLOCKED_DOMAINS=gmail.com,gmx.net,outlook.com

# APNs-Werte ausschliesslich als Umgebungsvariablen/Server-Secrets setzen.
# Den Inhalt der Apple-.p8-Datei mit escaped Zeilenumbruechen (\\n) speichern.
APNS_BUNDLE_ID=ch.example.app
APNS_TEAM_ID=APPLE_TEAM_ID
APNS_SANDBOX_KEY_ID=APPLE_KEY_ID
APNS_SANDBOX_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nPLACEHOLDER\n-----END PRIVATE KEY-----
APNS_PRODUCTION_KEY_ID=APPLE_KEY_ID
APNS_PRODUCTION_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nPLACEHOLDER\n-----END PRIVATE KEY-----
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
TSCHLUESSLI_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_SSL_MODE=verify-full
# Falls Infomaniak eine eigene CA liefert: PEM-Inhalt als mehrzeiliges Secret.
DATABASE_SSL_CA=

# Neue Infomaniak-MySQL-8.4-Zielumgebung. Benutzer und Datenbank sind pro
# Umgebung getrennt; echte Werte werden ausschliesslich als Server-Secrets gesetzt.
DATABASE_ENGINE=mysql
DATABASE_POOL_MAX=5
MYSQL_URL=mysql://tschluessli_api_dev:PLACEHOLDER@MYSQL_HOST:24856/tschluessli_dev
MYSQL_DIRECT_URL=mysql://tschluessli_api_dev:PLACEHOLDER@MYSQL_HOST:24856/tschluessli_dev
MYSQL_EXPECTED_DATABASE=tschluessli_dev
MYSQL_SSL_MODE=verify_identity
MYSQL_SSL_CA=
MYSQL_SSL_CA_PATH=/run/secrets/mysql-ca.cert
OBJECT_STORAGE_CONTAINER=tschluessli-dev-files
OBJECT_STORAGE_EXPECTED_CONTAINER=tschluessli-dev-files
OBJECT_STORAGE_ENDPOINT=https://OBJECT-STORAGE-ENDPOINT
OBJECT_STORAGE_ACCESS_KEY=PLACEHOLDER
OBJECT_STORAGE_SECRET_KEY=PLACEHOLDER
OBJECT_STORAGE_REGION=dc4
STORAGE_DRIVER=disabled
TRUST_ACCESS_GRACE_SECONDS=60
CRON_SECRET=PLACEHOLDER
APP_ENV=development
HOST=0.0.0.0
PORT=3000

# Compose-Variablen sind keine Secrets und werden ausserhalb von backend.env gesetzt.
# Dasselbe unveraenderte Image-Tag bzw. dessen Digest wird von DEV nach PROD promoted.
TSCHLUESSLI_IMAGE_REF=REGISTRY/TSCHLUESSLI-API@sha256:IMAGE_DIGEST
TSCHLUESSLI_HOST_PORT=3000
